{
  "name": "bawabu",
  "version": "0.1.0",
  "description": "A gatekeeper between AI coding agents and the packages they install.",
  "type": "module",
  "bin": {
    "bawabu": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
