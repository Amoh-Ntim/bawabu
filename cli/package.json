  "keywords": [
    "security",
    "supply-chain",
    "npm",
    "ai-agents",
    "muse-code",
    "malware",
    "sandbox"
  ],
  "license": "MIT",
  "author": "Samuel Amoh Ntim",
  "homepage": "https://github.com/Amoh-Ntim/bawabu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amoh-Ntim/bawabu.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/Amoh-Ntim/bawabu/issues",
  "type": "module",
  "bin": {
    "bawabu": "dist/cli.js"
